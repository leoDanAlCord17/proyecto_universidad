# Copia este archivo como .env y rellena los valores reales.
# NUNCA subas .env al repositorio — está en .gitignore.
#
# Cómo obtener estos valores:
#   1. Entra a https://supabase.com → tu proyecto → Settings → API
#   2. Copia "Project URL" en SUPABASE_URL
#   3. Copia "anon public" key en SUPABASE_ANON_KEY

SUPABASE_URL=https://tu-proyecto.supabase.co
SUPABASE_ANON_KEY=tu_anon_key_aqui

# Sentry (opcional — solo para producción)
# Obtén el DSN en: https://sentry.io → tu proyecto → Settings → Client Keys
# Si no está configurado, los errores solo se loggean en consola.
SENTRY_DSN=
